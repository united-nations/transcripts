# Copy to .env.local and fill in values

# ── Web app (required) ───────────────────────────────────────────────

# Azure Database for PostgreSQL — connect directly on port 5432
# The webtv_app role is scoped to the webtv schema only (see sql/schema.sql)
DATABASE_URL=postgresql://user:PASSWORD@server.postgres.database.azure.com:5432/db?sslmode=require

# Speech-to-text is routed per language (see lib/providers/config.ts STT_ROUTING).
# The web app therefore needs the keys for every routed provider:
#   floor (multilingual) → Speechmatics Melia
#   en/fr/es/ar/ru → Azure AI Speech (LLM Speech enhanced mode)
#   Chinese → Alibaba (DashScope)
# English moved off AssemblyAI on 2026-07-30 — it silently omits speech on long
# audio (eval/analysis/SYNTHESIS.md §16). ASSEMBLYAI_API_KEY is now eval-only.
# Gemini is used for PV document alignment (and as the routing fallback).
GEMINI_API_KEY=
SPEECHMATICS_API_KEY=
DASHSCOPE_API_KEY=

# en/fr/es/ar/ru transcription — Azure AI Speech, LLM Speech "enhanced mode".
# NOTE: a different service and rate card from AZURE_OPENAI_* below. Enhanced mode
# only answers on the <resource>.services.ai.azure.com hostname.
AZURE_SPEECH_KEY=
AZURE_SPEECH_ENDPOINT=https://{resource}.services.ai.azure.com/

# Postprocessing (Sol for analysis, Luna for sentence tagging).
# Optional overrides; these are also the code defaults.
# STT_ANALYSIS_MODEL=gpt-6.1-sol
# STT_ANALYSIS_MODEL_MINI=gpt-6-luna
# STT_ANALYSIS_MODEL_NANO=gpt-6-luna
AZURE_OPENAI_ENDPOINT=https://{resource}.openai.azure.com/
AZURE_OPENAI_API_VERSION=2025-03-01-preview
AZURE_OPENAI_API_KEY=

# Auth — magic-link login. Required to generate transcripts. Experimental
# features (proposition analysis, speaker directory) additionally require the
# per-user `experimental_access` flag, toggled directly in psql.
# Auth tables live in the webtv schema (apply sql/migrations/002_add_auth_tables.sql).
AUTH_SECRET=                       # openssl rand -hex 32
# Outbound email transport. If EMAIL_RELAY_URL is set, all mail is POSTed to an
# Azure Logic App that sends it from the transcripts-app-noreply@un.org shared
# mailbox (aligned SPF/DKIM/DMARC on un.org). If unset, mail goes out via SMTP
# below. Unset EMAIL_RELAY_URL to fall back to SMTP instantly.
EMAIL_RELAY_URL=                    # Logic App HTTP-trigger URL (contains a SAS sig — treat as secret)
EMAIL_RELAY_SECRET=                 # sent as the JSON `auth` field, checked by the Logic App; openssl rand -hex 32

# SMTP fallback (used only when EMAIL_RELAY_URL is unset).
SMTP_HOST=smtp.mailbox.org
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=                         # falls back to SMTP_USER if unset

# ── Web app (optional) ──────────────────────────────────────────────

# Vercel cron job auth (auto-set by Vercel in production)
# CRON_SECRET=

# Canonical public base URL for links in outbound email (magic-link sign-in,
# transcript notifications). REQUIRED IN PRODUCTION: these links are resolved
# from config only (never the request Host), so a missing value fails closed
# (email send throws) rather than emitting a Host-poisonable link. In dev it
# defaults to http://localhost:3000.
# BASE_URL=https://your-domain.example

# Daily caps on transcript starts (count-based, env-overridable, reset at UTC
# midnight). Per-user keeps any one account from running away with cost;
# global is the aggregate ceiling and trips a Sentry "global_daily_ceiling"
# warning when exceeded.
# TRANSCRIBE_USER_DAILY_LIMIT=5
# TRANSCRIBE_GLOBAL_DAILY_LIMIT=50

# Postgres pool — per Vercel instance. PgBouncer (port 6432) does the real
# fan-in, so a small per-instance pool is the right shape. Long-running
# scripts can override.
# PG_POOL_MAX=2
# PG_SSL_CA=                         # PEM path; only if Azure's chain ever leaves Node's bundle

# Sentry (errors + user feedback widget). DSN is public; the auth token is
# only used at build time to upload source maps and should be Vercel-only.
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=                        # same value as above; used server-side
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=                 # Vercel env only — never commit
# SENTRY_TRACES_SAMPLE_RATE=0        # raise to 0.1 etc. to enable perf tracing

# Umami analytics (privacy-first, cookieless). Set the website ID from your
# Umami dashboard; override SRC if self-hosted.
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# NEXT_PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js

# Search engine site ownership verification (Search Console / Bing Webmaster
# Tools). Each console hands you a token after you add the property; paste it
# here and redeploy. Both consoles also accept DNS-record verification as an
# alternative — use whichever your DNS/deploy story prefers.
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=

# ── Eval system only ────────────────────────────────────────────────
# Extra STT providers benchmarked in eval/ but not used by the web app.
# (DASHSCOPE_API_KEY and AZURE_SPEECH_* are above — they are production-required.)

ASSEMBLYAI_API_KEY=
ELEVENLABS_API_KEY=
GROQ_API_KEY=
DEEPGRAM_API_KEY=
MISTRAL_API_KEY=

# HuggingFace (corpus & results upload)
HF_TOKEN=

# Google Cloud (Chirp STT)
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_BUCKET=
